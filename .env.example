# Copy to .env and fill in your credentials
BITFLYER_API_KEY=your_api_key_here
BITFLYER_API_SECRET=your_api_secret_here

# 1=ドライラン（注文を実際には出さない）、0=本番
# 実発注は「DRY_RUN=0」かつ「bot --live」のときだけ。どちらかが欠ければドライランになる
DRY_RUN=1

# 取引ペア: FX_BTC_JPY（Crypto CFD: 証拠金・建玉で管理）or BTC_JPY（現物）
SYMBOL=FX_BTC_JPY

# 使用する時間足: 3H, 6H, 12H, 1D
# PDCA結果: 1D + STOP_3ATR が最良 (OOS net=+128,929 JPY, WR=75%, PF=2.06)
TIMEFRAME=1D

# 使用するバリアント（python -m autoflyer variants で一覧表示）
# 推奨: BREAKOUT_STOP1.5_GARCH40 (4.3年バックテスト最高リターン +306%, PF 6.03)
VARIANT=BREAKOUT_STOP1.5_GARCH40

# 1取引あたりの資金（円）。0=残高全額を使う
# 失っても許容できる額を設定すること（最大DD約18.5%）
TRADE_AMOUNT_JPY=100000

# ループ間隔（秒）
POLL_INTERVAL_SEC=60

# ダッシュボード Basic 認証（設定すると 0.0.0.0 で外部公開、未設定だと localhost のみ）
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# メール通知（SMTP設定。未設定の場合は通知無効）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
NOTIFY_TO=a2gwhitex@icloud.com

# Slack 通知（Incoming Webhook の URL。未設定なら無効）
SLACK_WEBHOOK_URL=

# LINE 通知（Messaging API のチャネルアクセストークンと送信先ユーザー ID。未設定なら無効）
# ※ LINE Notify は 2025 年 3 月に終了したため Messaging API を使う
LINE_CHANNEL_TOKEN=
LINE_TO=

# 日次サマリーを送る時刻（JST の時、0-23）。-1 で送らない
DAILY_SUMMARY_HOUR=9
