# Copy to .env and fill in your credentials
BITFLYER_API_KEY=your_api_key_here
BITFLYER_API_SECRET=your_api_secret_here

# 1=ドライラン（注文を実際には出さない）、0=本番
DRY_RUN=1

# 取引ペア: FX_BTC_JPY or BTC_JPY
SYMBOL=FX_BTC_JPY

# 使用する時間足: 3H, 6H, 12H, 1D
# PDCA結果: 1D + STOP_3ATR が最良 (OOS net=+128,929 JPY, WR=75%, PF=2.06)
TIMEFRAME=1D

# 使用するバリアント（python -m autoflyer variants で一覧表示）
# 推奨: MA200_STOP1.5ATR_GARCH40 (8年グリッドサーチ最優秀 Calmar 1.20)
VARIANT=MA200_STOP1.5ATR_GARCH40

# 1取引あたりの資金（円）。0=残高全額を使う
# 失っても許容できる額を設定すること（最大DD約24%）
TRADE_AMOUNT_JPY=50000

# ループ間隔（秒）
POLL_INTERVAL_SEC=60

# ダッシュボード Basic 認証（設定すると外部公開、未設定だと localhost のみ）
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme
