# Copy to .env and fill in your credentials
BITFLYER_API_KEY=your_api_key_here
BITFLYER_API_SECRET=your_api_secret_here

# 1=ドライラン（注文を実際には出さない）、0=本番
DRY_RUN=1

# 取引ペア: FX_BTC_JPY or BTC_JPY
SYMBOL=FX_BTC_JPY

# 使用する時間足: 3H, 6H, 12H, 1D
# PDCA結果: 1D + STOP_3ATR が最良 (OOS net=+128,929 JPY, WR=75%, PF=2.06)
TIMEFRAME=1D

# 使用するバリアント（python -m autoflyer variants で一覧表示）
# 推奨: BREAKOUT_STOP1.5_GARCH40 (4.3年バックテスト最高リターン +306%, PF 6.03)
VARIANT=BREAKOUT_STOP1.5_GARCH40

# 1取引あたりの資金（円）。0=残高全額を使う
# 失っても許容できる額を設定すること（最大DD約18.5%）
TRADE_AMOUNT_JPY=100000

# ループ間隔（秒）
POLL_INTERVAL_SEC=60

# ダッシュボード Basic 認証（設定すると 0.0.0.0 で外部公開、未設定だと localhost のみ）
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# メール通知（SMTP設定。未設定の場合は通知無効）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
NOTIFY_TO=a2gwhitex@icloud.com
